MEMSHIFT @WELCOME(200),32768+44+200,32
FOR DELAY = 1 TO 2500: NEXT DELAY

CALL MOVE_TO(15,20)
IF FLIP = 1 THEN
	PRINT "{rev_on}press a key"
        FLIP = 0
ELSE
	PRINT "press a key"
        FLIP = 1
END IF

	CALL CHECK_KEY()

LOOP

END SUB

SUB OVER_PETSCII()


    K$=""
    MEMSHIFT @over_screen,32768,1000
    DO WHILE K$=""
	CALL CHECK_KEY()
        
    LOOP


END SUB

CALL WELCOME_PETSCII()
CALL OVER_PETSCII()

