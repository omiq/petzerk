DIM I AS INT
DIM R AS INT
DIM FLIP AS BYTE: FLIP=0
DIM K$ AS STRING * 1: K$=""
DIM DELAY AS INT
DIM WELCOME(1000) AS BYTE @welcome_screen
DIM WELCOME_XOR(1000) AS BYTE

SUB CHECK_KEY()

  REM IS THERE A KEY IN THE KEYBOARD BUFFER?	
  IF PEEK(158)>0 THEN 

    REM GET THE KEY FROM THE KEYBOARD BUFFER
    GET K$
    PRINT CHR$(147)

  END IF

END SUB


SUB MOVE_TO(TEXT_X AS BYTE, TEXT_Y AS BYTE)

  PRINT CHR$(19); : REM HOME

  FOR I = 0 TO TEXT_Y - 1
    PRINT CHR$(17); : REM CURSOR DOWN
  NEXT I

  FOR I = 0 TO TEXT_X - 1
    PRINT CHR$(29); : REM CURSOR RIGHT
  NEXT I
END SUB


SUB WELCOME_PETSCII()

PRINT "{clr}    beta test mar 2026"

TEXTAT 8,11,"a:left d:right space:fire"
TEXTAT 14,14,"your mission:"
TEXTAT 14,15,"{100}{100}{100}{100}{100}{100}{100}{100}{100}{100}{100}{100}{100}"
TEXTAT 10,16,"destroy all the aliens"
TEXTAT 8,17,"before they conquer earth!"


FOR R=0 TO 5
FOR I=0 TO 32
  WELCOME_XOR(R*40+I)=WELCOME(R*40+I) XOR 128
NEXT I
NEXT R


DO WHILE K$=""

MEMSHIFT @WELCOME(0),32768+44,32
