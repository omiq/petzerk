REM Recalc ALIEN_LEFT/RIGHT from living aliens only (column from stored X so bounds match visible formation)
SUB UPDATE_ALIEN_BOUNDS()
  LEFTMOST_COL=10
  RIGHTMOST_COL=-1
  FOR IDX=0 TO 49
    IF ALIENS(IDX).STATE=1 THEN
      REM Column index from alien's stored X offset (0,2,4..18 -> 0..9)
      AL=ALIENS(IDX).X/2
      IF AL<LEFTMOST_COL THEN LEFTMOST_COL=AL
      IF AL>RIGHTMOST_COL THEN RIGHTMOST_COL=AL
    END IF
  NEXT IDX
  IF RIGHTMOST_COL>=0 THEN
    ALIEN_LEFT=ALIEN_BASE+LEFTMOST_COL*2
    ALIEN_RIGHT=ALIEN_BASE+RIGHTMOST_COL*2
  END IF
END SUB

REM Drop formation one line (when reversing); uses WIDTH, ALIEN_LEFT, ALIEN_RIGHT, ALIEN_TOP, ALIEN_BOTTOM
SUB DROP_ALIENS()
  IF ALIEN_BOTTOM+1>=24 THEN RETURN
  REM Copy each alien row down by 1, bottom to top so we don't overwrite
  FOR ROW=ALIEN_BOTTOM TO ALIEN_TOP STEP -2
    SRC=SCREENADDRESS+(40*ROW)+ALIEN_LEFT
    DST=SCREENADDRESS+(40*(ROW+1))+ALIEN_LEFT
    MEMCPY SRC,DST,WIDTH
    FOR AL=0 TO WIDTH-1
      POKE SCREENADDRESS+(40*ROW)+ALIEN_LEFT+AL,32
    NEXT AL
  NEXT ROW
  ALIEN_TOP=ALIEN_TOP+1
  ALIEN_BOTTOM=ALIEN_BOTTOM+1
  FOR I=0 TO 49
    ALIENS(I).Y=ALIENS(I).Y+1
  NEXT I
  CALL UPDATE_ALIEN_BOUNDS()
END SUB

REM MOVE THE ACTIVE ALIENS WITHIN THE BOUNDS
REM Uses MEMCPY/MEMSHIFT for fast block movement (MEMCPY=downwards overlap, MEMSHIFT=upwards)
REM Only copies alien rows (0,2,4,6,8) to avoid shifting bullets in gap rows
SUB MOVE_ALIENS()
  REM Bounds from living aliens only; clear dead cells so shifted block = visible formation
  CALL UPDATE_ALIEN_BOUNDS()
  FOR IDX=0 TO 49
    IF ALIENS(IDX).STATE=0 THEN
      POKE SCREENADDRESS+(40*ALIENS(IDX).Y)+ALIEN_BASE+ALIENS(IDX).X,32
    END IF
  NEXT IDX
  REM Recalc after clear (no change) so WIDTH uses tight bounds
  CALL UPDATE_ALIEN_BOUNDS()

  WIDTH=ALIEN_RIGHT-ALIEN_LEFT+1
  IF WIDTH<=0 THEN RETURN
  IF ALIEN_LEFT<=0 AND ALIEN_DIRECTION=-1 THEN
    CALL DROP_ALIENS()
    ALIEN_DIRECTION=1
  END IF
  IF ALIEN_RIGHT>=39 AND ALIEN_DIRECTION=1 THEN
    CALL DROP_ALIENS()
    ALIEN_DIRECTION=-1
  END IF

  WIDTH=ALIEN_RIGHT-ALIEN_LEFT+1
  REM Only move if we won't go out of bounds (use updated bounds so formation hits 0 and 39)
  REM IF (ALIEN_DIRECTION=1 AND ALIEN_RIGHT<39) OR (ALIEN_DIRECTION=-1 AND ALIEN_LEFT>0) THEN

    IF ALIEN_DIRECTION=1 THEN
      REM Move right: dest>src, use MEMSHIFT (overlap-safe upwards)
      FOR ROW=ALIEN_TOP TO ALIEN_BOTTOM STEP 2
        SRC=SCREENADDRESS+(40*ROW)+ALIEN_LEFT
        DST=SCREENADDRESS+(40*ROW)+ALIEN_LEFT+1
        MEMSHIFT SRC,DST,WIDTH
        POKE SCREENADDRESS+(40*ROW)+ALIEN_LEFT,32
      NEXT ROW
    ELSE
      REM Move left: copy whole block one column left (src=LEFT..RIGHT to dst=LEFT-1..RIGHT-1), then clear vacated right
      FOR ROW=ALIEN_TOP TO ALIEN_BOTTOM STEP 2
        SRC=SCREENADDRESS+(40*ROW)+ALIEN_LEFT
        DST=SCREENADDRESS+(40*ROW)+ALIEN_LEFT-1
        MEMCPY SRC,DST,WIDTH
        POKE SCREENADDRESS+(40*ROW)+ALIEN_RIGHT,32
      NEXT ROW
    END IF

    ALIEN_BASE=ALIEN_BASE+ALIEN_DIRECTION
  

  REM END IF
END SUB