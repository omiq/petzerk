REM Petvaders v1
REM Recreation of the classic arcadegame "space invaders" in XC-BASIC
REM for the Commodore PET
REM Chris Garrett 2026
REM RetroGameCoders.com
REM ========================================================

REM SCREEN ADDRESS SO MORE PORTABLE
CONST SCREENADDRESS = 32768

REM low byte of system clock
DIM LASTTICK AS BYTE


REM BADDIES:
TYPE ALIEN
  X AS INT
  Y AS INT
  STATE AS INT
  BULLETX AS INT
  BULLETY AS INT
  BULLETSTATE AS INT
END TYPE

REM INITIALISE
DIM LIVES AS INT: LIVES=3
DIM FAST X AS INT
DIM FAST Y AS INT
DIM OLDX AS INT
DIM OLDY AS INT
DIM FAST BX AS INT
DIM FAST BY AS INT
DIM FAST BF AS INT
DIM FAST IDX AS BYTE
DIM FAST AL AS INT
X=10
Y=10
K$=""
GAME_OVER = 0
DIM SCORE AS INT: SCORE=0
DIM HIGH_SCORE AS INT: HIGH_SCORE=0
DIM OLDSCORE AS INT: DIM OLDLIVES AS INT
DIM OLDALIENS AS INT: OLDALIENS=-1
DIM LIVE_CNT AS INT

REM C IS CHARACTER READ FROM THE SCREEN
DIM FAST C AS BYTE: C=32


REM 5 ROWS OF 10 ALIENS
DIM ALIENS_COUNT AS INT
DIM ALIENS(50) AS ALIEN
DIM FAST ALIEN_LEFT AS INT
DIM FAST ALIEN_RIGHT AS INT
DIM FAST ALIEN_TOP AS INT
DIM FAST ALIEN_BOTTOM AS INT
DIM FAST ALIEN_DIRECTION AS INT: ALIEN_DIRECTION=1
DIM FAST THIS_ALIEN AS INT

REM FOR DISPLAYING ALIENS
DIM ALIEN_ROW(6) AS STRING * 23
DIM TOP_ALIEN AS BYTE
DIM BOTTOM_ALIEN AS BYTE

REM LEFT, RIGHT, TOP, BOTTOM are the bounds of the alien grid
REM when we move the aliens we use these bounds so we know when
REM to change direction and move down a row.
DIM ROW AS INT
DIM FAST WIDTH AS BYTE
DIM SRC AS WORD
DIM DST AS WORD

REM ALIEN_CHAR is the character to use for the alien (13=M, 23=W)
REM ALIENS SWITCH BETWEEN M AND W ON EACH FRAME

DIM ALIEN_CHAR AS BYTE: ALIEN_CHAR=13
DIM FAST I AS BYTE
DIM FAST A AS BYTE
DIM FAST DIDX AS BYTE
DIM FAST STR_LINE$ AS STRING * 40
STR_LINE$ = "                                        "


SUB HUD()

  REM TEXTAT 0,22,"score:"+STR$(SCORE)+" lives:"+STR$(LIVES)+" high:"+STR$(HIGH_SCORE)+" aliens:"+STR$(ALIENS_COUNT)
  TEXTAT 0,0," bottom:"+STR$(ALIEN_BOTTOM)+" top:"+STR$(ALIEN_TOP)+" l:"+STR$(ALIEN_LEFT)+" r:"+STR$(ALIEN_RIGHT)
  

END SUB


SUB UPDATE_BOUNDS()
  REM Init bounds so min/max are found from living aliens this frame
  ALIEN_LEFT=40
  ALIEN_RIGHT=-1
  FOR IDX=0 TO 49
    IF ALIENS(IDX).STATE=1 THEN
      IF ALIENS(IDX).X<ALIEN_LEFT THEN ALIEN_LEFT=ALIENS(IDX).X
      IF ALIENS(IDX).X>ALIEN_RIGHT THEN ALIEN_RIGHT=ALIENS(IDX).X
      IF ALIENS(IDX).Y<ALIEN_TOP THEN ALIEN_TOP=ALIENS(IDX).Y
      IF ALIENS(IDX).Y>ALIEN_BOTTOM THEN ALIEN_BOTTOM=ALIENS(IDX).Y
    END IF
  NEXT IDX
  
END SUB


SUB ERASE_ALIENS()

  TMP = SCREENADDRESS+(40*ALIEN_TOP)+ALIEN_LEFT
  WIDTH = ALIEN_RIGHT-ALIEN_LEFT+4
  TEXTAT ALIEN_LEFT,ALIEN_TOP,LEFT$(STR_LINE$,WIDTH)
  TEXTAT ALIEN_LEFT,ALIEN_TOP+2,LEFT$(STR_LINE$,WIDTH)
  TEXTAT ALIEN_LEFT,ALIEN_TOP+4,LEFT$(STR_LINE$,WIDTH)
  TEXTAT ALIEN_LEFT,ALIEN_TOP+6,LEFT$(STR_LINE$,WIDTH)
  TEXTAT ALIEN_LEFT,ALIEN_TOP+8,LEFT$(STR_LINE$,WIDTH)

END SUB

SUB DRAW_ALIENS()

  TEXTAT ALIEN_LEFT,ALIEN_TOP,ALIEN_ROW(1)
  TEXTAT ALIEN_LEFT,ALIEN_TOP+2,ALIEN_ROW(2)
  TEXTAT ALIEN_LEFT,ALIEN_TOP+4,ALIEN_ROW(3)
  TEXTAT ALIEN_LEFT,ALIEN_TOP+6,ALIEN_ROW(4)
  TEXTAT ALIEN_LEFT,ALIEN_TOP+8,ALIEN_ROW(5)

END SUB

SUB INIT_ALIENS()

  REM Store screen X: TEXTAT " m w..." puts first alien at ALIEN_LEFT+1, not ALIEN_LEFT
  ALIENS_COUNT=0
  FOR Y=ALIEN_TOP TO ALIEN_BOTTOM-1 STEP 2
    FOR X=ALIEN_LEFT TO ALIEN_RIGHT-1 STEP 2
      ALIENS(ALIENS_COUNT).X=X+1
      ALIENS(ALIENS_COUNT).Y=Y
      ALIENS(ALIENS_COUNT).STATE=1
      ALIENS(ALIENS_COUNT).BULLETX=0
      ALIENS(ALIENS_COUNT).BULLETY=0
      ALIENS_COUNT=ALIENS_COUNT+1
    NEXT X
  NEXT Y
  
  ALIEN_ROW(1) = " a b c d e f g h i j  "
  ALIEN_ROW(2) = " a b c d e f g h i j  "
  ALIEN_ROW(3) = " a b c d e f g h i j  "
  ALIEN_ROW(4) = " a b c d e f g h i j  "
  ALIEN_ROW(5) = " a b c d e f g h i j  "
  CALL UPDATE_BOUNDS()

END SUB

SUB INITIAL_DRAW()

  REM BASES
  TEXTAT 5,19,CHR$(140)+CHR$(140)+CHR$(140)
  TEXTAT 5,20,CHR$(140)+CHR$(140)+CHR$(140)
  TEXTAT 5,21,CHR$(140)+CHR$(32)+CHR$(140)
  TEXTAT 5,22,CHR$(140)+CHR$(32)+CHR$(140)

  TEXTAT 14,19,CHR$(140)+CHR$(140)+CHR$(140)
  TEXTAT 14,20,CHR$(140)+CHR$(140)+CHR$(140)
  TEXTAT 14,21,CHR$(140)+CHR$(32)+CHR$(140)
  TEXTAT 14,22,CHR$(140)+CHR$(32)+CHR$(140)

  TEXTAT 23,19,CHR$(140)+CHR$(140)+CHR$(140)
  TEXTAT 23,20,CHR$(140)+CHR$(140)+CHR$(140)
  TEXTAT 23,21,CHR$(140)+CHR$(32)+CHR$(140)
  TEXTAT 23,22,CHR$(140)+CHR$(32)+CHR$(140)

  TEXTAT 32,19,CHR$(140)+CHR$(140)+CHR$(140)
  TEXTAT 32,20,CHR$(140)+CHR$(140)+CHR$(140)
  TEXTAT 32,21,CHR$(140)+CHR$(32)+CHR$(140)
  TEXTAT 32,22,CHR$(140)+CHR$(32)+CHR$(140)

  REM HUD
  CALL HUD()
  
  CALL DRAW_ALIENS()

END SUB

SUB WAIT_KEY()

  DIM KEY$ AS STRING * 1
  KEY$=""
  DO WHILE KEY$=""
    GET KEY$
  LOOP

END SUB

SUB DROP_ALIENS()
 
  ALIEN_TOP=40
  ALIEN_BOTTOM=-1
 
  FOR DIDX=TOP_ALIEN TO BOTTOM_ALIEN
    IF ALIENS(DIDX).STATE=1 THEN
      ALIENS(DIDX).Y=ALIENS(DIDX).Y+1
      IF ALIENS(DIDX).Y > ALIEN_BOTTOM THEN 
      	ALIEN_BOTTOM = ALIENS(DIDX).Y
      END IF
      IF ALIENS(DIDX).Y < ALIEN_TOP THEN 
      	ALIEN_TOP = ALIENS(DIDX).Y
      END IF
    END IF
  NEXT DIDX

  IF ALIEN_BOTTOM > 22 THEN 
  	GAME_OVER = 1
        LIVES = 0
  END IF

END SUB



SUB MOVE_ALIENS()

  CALL UPDATE_BOUNDS()

  IF ALIEN_LEFT<=2 AND ALIEN_DIRECTION=-1 THEN 
   ALIEN_DIRECTION=1

   CALL ERASE_ALIENS()
   CALL DROP_ALIENS()

  END IF
  IF ALIEN_RIGHT>=36 AND ALIEN_DIRECTION=1 THEN 
   ALIEN_DIRECTION=-1
   CALL ERASE_ALIENS()
   CALL DROP_ALIENS()
  END IF

  FOR IDX=0 TO 49
    IF ALIENS(IDX).STATE=1 THEN
	ALIENS(IDX).X=ALIENS(IDX).X+ALIEN_DIRECTION
    END IF
  NEXT IDX


  CALL DRAW_ALIENS()
  CALL HUD()


END SUB

SUB ALIEN_KILL()

    

       FOR THIS_ALIEN=BOTTOM_ALIEN TO TOP_ALIEN STEP -1
       
         IF BY=ALIENS(THIS_ALIEN).Y AND BX=ALIENS(THIS_ALIEN).X THEN
         
                 POKE SCREENADDRESS+(40*BY)+BX,42
        	BF=0

           PRINT STR$(THIS_ALIEN) + ": "+ STR$(ALIENS(THIS_ALIEN).STATE)+" "+STR$(BX) + "=" + STR$(ALIENS(THIS_ALIEN).X) + " " + STR$(BY)  + "=" + STR$(ALIENS(THIS_ALIEN).Y)


           ALIENS(THIS_ALIEN).STATE=0
           SCORE=SCORE+10
           ALIENS_COUNT=ALIENS_COUNT-1

           REM UPDATE HUD
           CALL HUD()
           
           POKE @ALIEN_ROW(5-(ALIEN_BOTTOM-ALIENS(THIS_ALIEN).Y)/2) + (ALIENS(THIS_ALIEN).X-ALIEN_LEFT)+1, 32
           IF ALIENS_COUNT<=0 THEN GAME_OVER=1
    
         
         
         END IF
       NEXT THIS_ALIEN

END SUB

REM BULLET MOVEMENT
SUB PLAYER_SHOT()

    POKE SCREENADDRESS+(40*BY)+BX,32
    
    IF BY < ALIEN_TOP THEN 
    	BF=0
        RETURN 
    ELSE
        BY=BY-1

        C=PEEK(SCREENADDRESS+(40*BY)+BX)

        IF C=32 THEN 
            POKE SCREENADDRESS+(40*BY)+BX,34
            TEXTAT 0,0,"                   "
            RETURN
        ELSE
            CALL ALIEN_KILL()
            RETURN
        END IF

    END IF
END SUB

SUB WELCOME()

  PRINT CHR$(147);CHR$(142)
  PRINT "{13}petvaders"
  PRINT "chris garrett 2026{13}retrogamecoders.com"
  PRINT "{13}{13}press a key to play"
  CALL WAIT_KEY()
  PRINT CHR$(147);

END SUB

SUB END_SCREEN()
  PRINT CHR$(147)


  IF LIVES <=0 THEN 
      PRINT "game over!"
  ELSE 
      PRINT "you win!"
  END IF

  IF SCORE > HIGH_SCORE THEN 
    HIGH_SCORE = SCORE
    PRINT "new high score!"
    PRINT "score: ";SCORE

  ELSE
   PRINT "score: ";SCORE
   PRINT "high score: ";HIGH_SCORE
  END IF
  PRINT "press a key to continue"
  CALL WAIT_KEY()
  
END SUB


SUB INIT_GAME()

  REM RESET THE PLAYER AND GAME VARIABLES
  LIVES=3: GAME_OVER=0: SCORE=0: BF=0: BX=0: BY=0
  ALIEN_DIRECTION=1: ALIEN_LEFT=12: ALIEN_RIGHT=ALIEN_LEFT+20
  ALIEN_TOP=1: ALIEN_BOTTOM=10

  CALL INIT_ALIENS()
  CALL INITIAL_DRAW()
  
  
  REM PLAYER START POSITIONS
  X=20: Y=23
  POKE SCREENADDRESS+(40*Y)+X,65
   

END SUB


REM INFINITE LOOP FOR THE GAME OUTER LOOP 
DO WHILE 1

REM WELCOME SCREEN
CALL WELCOME()

CALL INIT_GAME()

 
  REM GAMEPLAY LOOP
  DO WHILE GAME_OVER <> 1 AND LIVES > 0
  
    REM '
    IF PEEK(158)>0 THEN 
    	GET K$
      IF K$="Q" OR K$="q" THEN
        LIVES=0 
        GAME_OVER = 1
      END IF
      
      IF K$="D" OR K$="d" AND X<39 THEN 
      	X=X+1
        TEXTAT X-1,Y," {193} "
      END IF
      
      IF K$="A" OR K$="a" AND X>1  THEN 
      	X=X-1
        TEXTAT X-1,Y," {193} "
      END IF
      
      IF K$=" " AND BF=0 THEN 
        BX=X
        BY=Y-1
        BF=1
      END IF
      
    END IF

    IF PEEK(143) MOD 20 = 0 THEN CALL MOVE_ALIENS() 
    IF BF=1 THEN CALL PLAYER_SHOT()

  LOOP

  REM GAME OVER SCREEN
  CALL END_SCREEN()

REM OUTER LOOP FOR THE GAME
LOOP
